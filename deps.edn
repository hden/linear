{:paths ["src" "resources"]
 :deps {org.clojure/clojure                 {:mvn/version "1.12.6"}
        org.apache.commons/commons-pool2    {:mvn/version "2.13.1"}
        org.duct-framework/main             {:mvn/version "0.4.9"}
        org.duct-framework/module.logging   {:mvn/version "0.6.6"}
        org.duct-framework/module.sql       {:mvn/version "0.9.0"}
        org.duct-framework/module.web       {:mvn/version "0.13.5"}
        org.duct-framework/test             {:mvn/version "0.1.0"}
        org.postgresql/postgresql           {:mvn/version "42.7.13"}
        org.replikativ/boring               {:mvn/version "0.1.30"}
        org.suskalo/coffi                   {:mvn/version "1.0.615"}
        com.cognitect/anomalies             {:mvn/version "0.1.12"}
        com.github.hden/ulid                {:mvn/version "0.1.0"}
        com.github.seancorfield/next.jdbc   {:mvn/version "1.3.1118"}
        com.github.seancorfield/honeysql    {:mvn/version "2.7.1479"}
        com.taoensso/tempel                 {:mvn/version "1.1.0"}
        com.google.cloud/google-cloud-kms   {:mvn/version "2.98.0"}
        camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}
        diehard/diehard                     {:mvn/version "0.12.1"}
        io.slatedb/slatedb-uniffi           {:mvn/version "0.17.0"}
        org.roaringbitmap/RoaringBitmap     {:mvn/version "1.6.23"}
        funcool/promesa                     {:mvn/version "12.0.1"}
        com.github.hden/labrador            {:mvn/version "0.2.0"}
        metosin/malli                       {:mvn/version "0.20.2"}
        hden/duct.auth.jwks                 {:mvn/version "0.2.2"}
        buddy/buddy-sign                    {:mvn/version "3.5.351"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}
                      ring/ring-mock       {:mvn/version "0.6.2"}}}
  :duct {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "duct.main"]}
  :lint {:replace-paths ["scripts"]
         :replace-deps {org.clojure/clojure {:mvn/version "1.12.6"}
                        org.clojure/core.match {:mvn/version "1.1.1"}
                        org.clojure/tools.namespace {:mvn/version "1.5.1"}
                        clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
         :main-opts ["-m" "linear.lint"]}
  :architecture {:replace-paths ["scripts"]
                 :replace-deps {org.clojure/clojure {:mvn/version "1.12.6"}
                                org.clojure/core.match           {:mvn/version "1.1.1"}
                                clj-kondo/clj-kondo              {:mvn/version "2026.08.04"}
                                org.clojure/tools.namespace     {:mvn/version "1.5.1"}}
                 :main-opts ["-m" "linear.architecture"]}
  :policy {:replace-paths ["scripts"]
           :replace-deps {org.clojure/clojure {:mvn/version "1.12.6"}
                          clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
           :main-opts ["-m" "linear.policy"]}
  :check {:extra-deps {io.github.athos/clj-check
                       {:git/tag "0.1.0"
                        :git/sha "0ca84df"}}
          :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
          :main-opts ["-m" "clj-check.check" "src"]}
  :cov  {:extra-paths ["test"]
         :extra-deps {cloverage/cloverage       {:mvn/version "1.2.4"}
                      ring/ring-mock            {:mvn/version "0.6.2"}
                      org.xerial/sqlite-jdbc     {:mvn/version "3.53.4.0"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "cloverage.coverage"
                     "-p" "src"
                     "-s" "test"
                     "--lcov"]}
  :crap {:extra-paths ["test"]
         :extra-deps {io.github.unclebob/crap4clj
                      {:git/url "https://github.com/unclebob/crap4clj"
                       :git/sha "e90be2e7aa02c2ec5d6544e9cecddc6b73ad3e4d"}
                      ring/ring-mock
                      {:mvn/version "0.6.2"}}
         :main-opts ["-m" "crap4clj.core"]}
  :crap-check {:extra-paths ["scripts"]
               :main-opts ["-m" "linear.crap"]}
  :e2e {:extra-paths ["test"]
        :extra-deps {org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}}
        :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
        :main-opts ["-m" "linear.e2e"]}}}
