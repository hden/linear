[{:id   "001-init"
  :up   ["CREATE TABLE transactions (
            id              text        PRIMARY KEY,
            idempotency_key text,
            actor           text,
            xid             bigint      NOT NULL DEFAULT txid_current(),
            metadata        jsonb,
            created_at      timestamptz NOT NULL DEFAULT now(),
            CONSTRAINT transactions_id_prefix CHECK (id LIKE 'tx-%')
          )"

         "CREATE UNIQUE INDEX transactions_idempotency
            ON transactions (idempotency_key) WHERE idempotency_key IS NOT NULL"

         "CREATE TABLE vaults (
            id               text        PRIMARY KEY,
            owner            text,
            ciphertext       bytea,
            encrypted_by     text,
            key_checksum     bytea       NOT NULL,
            metadata         jsonb,
            created_by       text        NOT NULL REFERENCES transactions (id),
            created_at       timestamptz NOT NULL DEFAULT now(),
            CONSTRAINT vaults_stored
              CHECK ((ciphertext IS NULL) = (encrypted_by IS NULL)),
            CONSTRAINT vaults_id_prefix CHECK (id LIKE 'v-%')
          )"

         "CREATE INDEX vaults_by_owner ON vaults (owner)"

         "CREATE TABLE vault_handovers (
            id           text        PRIMARY KEY,
            vault_id     text        NOT NULL REFERENCES vaults (id),
            ciphertext   bytea,
            artifact     bytea,
            created_by   text        NOT NULL REFERENCES transactions (id),
            created_at   timestamptz NOT NULL DEFAULT now(),
            CONSTRAINT vault_handovers_id_prefix CHECK (id LIKE 'h-%')
          )"

         "CREATE UNIQUE INDEX vault_handovers_holding
            ON vault_handovers (vault_id) WHERE ciphertext IS NOT NULL"

         "CREATE TABLE databases (
            id                     text        PRIMARY KEY,
            encrypted_by           text        NOT NULL REFERENCES vaults (id),
            current_revision       text,
            current_attributes     text,
            created_at             timestamptz NOT NULL DEFAULT now(),
            CONSTRAINT databases_id_prefix CHECK (id LIKE 'd-%')
          )"

