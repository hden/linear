# Load this file with your dotenv tool before starting Clojure.
# direnv configures the host native library path through .envrc.

# Deployment target: dev (default) or gcp. Other values are unsupported.
# LINEAR_DEPLOYMENT_TARGET=dev

# Required for authenticated vault and sync endpoints.
OIDC_ISSUER="https://example.us.auth0.com/"
OIDC_AUDIENCE="https://linear.example.com"

# Optional trusted JWKS endpoint override.
# OIDC_JWKS_URL="https://example.us.auth0.com/.well-known/jwks.json"

# Required when LINEAR_DEPLOYMENT_TARGET=gcp.
# GCP_KMS_KEY_NAME="projects/my-project/locations/global/keyRings/linear/cryptoKeys/kek"
# Google Application Default Credentials must be available to the process.
