# Load this file with your dotenv tool before starting Clojure.
# Replace the project path with the absolute path to this checkout.
JAVA_TOOL_OPTIONS="-Djava.library.path=/absolute/path/to/linear:/opt/homebrew/opt/sqlite/lib"

# Required for authenticated vault and sync endpoints.
OIDC_ISSUER="https://example.us.auth0.com/"
OIDC_AUDIENCE="https://linear.example.com"

# Optional trusted JWKS endpoint override.
# OIDC_JWKS_URL="https://example.us.auth0.com/.well-known/jwks.json"
