{:features #{:api}
 :handler-opts
 {:logger                             #ig/ref :duct/logger
  :linear.usecase.core/database       #ig/ref :linear.adapter.postgres/datasource
  :linear.usecase.core/revision-store #ig/ref :linear.adapter.slatedb.store/store
  :linear.usecase.core/evaluator      #ig/ref :linear.adapter.sqlite.evaluator/evaluator
  :linear.usecase.core/key-service    #ig/ref :linear.adapter.crypto/key-service}
 :middleware-opts
 {:provider #ig/ref :duct.auth.jwks/provider
  :issuer #ig/var oidc-issuer
  :audience #ig/var oidc-audience}
 :middleware [:linear.middleware.authentication/middleware
              :linear.handler.turso.push/request-body-limit]
 :routes
 [["/health/ready" {:get :linear.handler.health/ready}]
  ["/health/ok" {:get :linear.handler.health/ok}]
  ["/d/:id/pull-updates" {:post :linear.handler.turso.pull/handler}]
  ["/d/:id/v2/pipeline" {:post :linear.handler.turso.push/handler}]
  ["/control/v1/vaults" {:post :linear.handler.vault/create}]
  ["/control/v1/vaults/:id/databases" {:post :linear.handler.database/create
                                       :get :linear.handler.database/list-by-vault}]
  ["/control/v1/databases/:id" {:get :linear.handler.database/get-by-id
                                :patch :linear.handler.database/update-attributes
                                :delete :linear.handler.database/close}]
  ["/control/v1/vaults/:id" {:get :linear.handler.vault/get-state
                             :delete :linear.handler.vault/delete}]
  ["/control/v1/vaults/:id/recovery-token"
   {:get :linear.handler.vault/recovery-token
    :put :linear.handler.vault/restore}]
  ["/control/v1/vaults/:id/grants" {:get :linear.handler.grant/list-grants}]
  ["/control/v1/vaults/:id/grants/:subject"
   {:put :linear.handler.grant/set-grant
    :delete :linear.handler.grant/revoke-grant}]]}
