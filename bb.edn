{:tasks
 {main {:doc "Runs the application"
        :task (apply clojure "-M:duct" "--main" *command-line-args*)}
  test {:doc "Runs the test suite"
        :task (apply clojure "-M:duct:test" "--test" *command-line-args*)}
  policy:check {:doc "Checks non-suppressible source policies"
                :task (shell "clojure" "-M:policy")}
  lint {:doc "Checks source policies, architectural dependencies, public APIs, and clj-kondo findings without loading application code"
        :task (do
                (when (seq *command-line-args*)
                  (throw (ex-info "lint does not accept command-line arguments" {})))
                (shell "clojure" "-M:lint"))}
  architecture {:doc "Checks architectural dependency rules"
                :task (shell "clojure" "-M:architecture")}
  verify {:doc "Requires all static checks and application tests to pass"
          :task (do
                  (when (seq *command-line-args*)
                    (throw (ex-info "verify does not accept skip options" {})))
                  (doseq [task '[lint check format:check test]]
                    (run task)))}
  check {:doc "Loads source namespaces with reflection warnings enabled"
         :task (apply clojure "-M:check" *command-line-args*)}
  format:check {:doc "Checks Standard Clojure Style formatting"
                :task (apply shell "standard-clj" "check" "src" "test" "scripts" "deps.edn" "duct.edn" "bb.edn" *command-line-args*)}
  format:fix {:doc "Formats Clojure and EDN files"
              :task (apply shell "standard-clj" "fix" "src" "test" "scripts" "deps.edn" "duct.edn" "bb.edn"
                           *command-line-args*)}
  coverage {:doc "Runs Cloverage and writes LCOV data"
            :task (apply clojure "-M:cov" *command-line-args*)}
  crap {:doc "Runs CRAP analysis"
        :task (apply clojure "-M:crap" *command-line-args*)}
  crap:check {:doc "Checks CRAP scores against the supplied limit using existing coverage"
              :task (apply clojure "-M:crap:crap-check" *command-line-args*)}
  e2e {:doc "Runs the JavaScript Turso sync end-to-end test"
       :task (clojure "-M:e2e")}
  repl {:doc "Starts a REPL"
        :override-builtin true
        :task (clojure "-M:duct" "--repl" *command-line-args*)}}}
